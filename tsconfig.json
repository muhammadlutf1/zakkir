{
	"compilerOptions": {
		"target": "es2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"rootDir": ".",
		"outDir": "./dist"
	},
	"include": ["src", "__tests__"],
	"exclude": ["node_modules", "*.config.ts", "dist"]
}

{
	"name": "zakkir",
	"version": "1.0.0",
	"description": "A feature-rich Discord bot for 24/7 Quran streaming and audio services",
	"scripts": {
		"deploy:commands": "node --experimental-transform-types --env-file=.env src/scripts/deployCommands.ts",
		"dev": "node --experimental-transform-types --env-file=.env --watch src/index.ts",
		"start": "node --experimental-transform-types --env-file=.env src/index.ts",
		"test": "node --experimental-transform-types --test __tests__/**/*.test.ts",
		"lint": "biome check --error-on-warnings ./src ./__tests__",
		"lint:fix": "biome check --write ./src ./__tests__",
		"format": "biome format ./src ./__tests__",
		"format:fix": "biome format --write ./src ./__tests__"
	},
	"keywords": [],
	"author": "Muhammad Lutfi <mohamed10lotfy10@gmail.com>",
	"license": "ISC",
	"packageManager": "pnpm@11.3.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.3.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "24.13.3",
		"pino-pretty": "^13.1.3",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@discordjs/opus": "^0.10.0",
		"@discordjs/voice": "^0.19.2",
		"discord.js": "^14.27.0",
		"ffmpeg-static": "^5.3.0",
		"pino": "^10.3.1"
	}
}
